{
  "name": "pi-dual-agent-coordinator",
  "version": "0.1.0",
  "description": "Coordinator-driven dual-agent workflow engine built on the Pi SDK",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giantsoup/pi-dual-agent-coordinator.git"
  },
  "homepage": "https://github.com/giantsoup/pi-dual-agent-coordinator#readme",
  "bugs": {
    "url": "https://github.com/giantsoup/pi-dual-agent-coordinator/issues"
  },
  "keywords": [
    "agent",
    "cli",
    "coordinator",
    "mcp",
    "pi-sdk",
    "typescript",
    "workflow"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    ".nvmrc"
  ],
  "bin": {
    "pi-dual": "./dist/src/index.js"
  },
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=12.2.0 <13"
  },
  "scripts": {
    "auth": "node ./dist/src/index.js auth",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/build-skill-worker.mjs && node scripts/build-native.mjs",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "doctor": "node ./dist/src/index.js doctor",
    "repl": "node ./dist/src/index.js repl",
    "setup": "node ./dist/src/index.js setup",
    "prepare": "npm run build",
    "start": "node ./dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:isolation": "npm run build && node dist/src/security/verify-isolation.js && vitest run test/security",
    "secure:install": "node scripts/prepare-secure-runtime.mjs",
    "smoke:api": "node dist/src/security/smoke.js",
    "verify:terminal": "npm run build && python3 scripts/verify-terminal.py",
    "verify:local": "npm run build && node scripts/verify-local-executor.mjs",
    "verify:global-skills": "node scripts/verify-global-skills.mjs",
    "verify:global-mcp": "node scripts/verify-global-mcp.mjs",
    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "browser:allow": "node scripts/configure-local-browser.mjs",
    "verify:browser": "npm run build && node scripts/verify-browser-boundary.mjs && node scripts/verify-local-browser.mjs",
    "verify:local-servers": "npm run build && node scripts/verify-local-servers.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@lmstudio/sdk": "2.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "typebox": "1.4.2",
    "zod": "4.6.7"
  },
  "packageManager": "npm@12.2.0",
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true,
    "fsevents": false
  }
}
