{
  "name": "pi-dual-agent-coordinator",
  "version": "0.1.0",
  "description": "Coordinator-driven dual-agent workflow engine built on the Pi SDK",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giantsoup/pi-dual-agent-coordinator.git"
  },
  "homepage": "https://github.com/giantsoup/pi-dual-agent-coordinator#readme",
  "bugs": {
    "url": "https://github.com/giantsoup/pi-dual-agent-coordinator/issues"
  },
  "keywords": [
    "agent",
    "cli",
    "coordinator",
    "mcp",
    "pi-sdk",
    "typescript",
    "workflow"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    ".nvmrc"
  ],
  "bin": {
    "pi-dual": "./dist/src/index.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "ci": "npm run check && npm test",
    "doctor": "node ./dist/src/index.js doctor",
    "repl": "node ./dist/src/index.js repl",
    "prepare": "npm run build",
    "start": "node ./dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.67.68",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sinclair/typebox": "^0.34.49",
    "zod": "^4.3.6"
  }
}
