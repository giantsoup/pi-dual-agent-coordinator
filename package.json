{
  "name": "pi-dual-agent-coordinator",
  "version": "0.1.0",
  "description": "Coordinator-driven dual-agent workflow engine built on the Pi SDK",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giantsoup/pi-dual-agent-coordinator.git"
  },
  "homepage": "https://github.com/giantsoup/pi-dual-agent-coordinator#readme",
  "bugs": {
    "url": "https://github.com/giantsoup/pi-dual-agent-coordinator/issues"
  },
  "keywords": [
    "agent",
    "cli",
    "coordinator",
    "mcp",
    "pi-sdk",
    "typescript",
    "workflow"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    ".nvmrc"
  ],
  "bin": {
    "pi-dual": "./dist/src/index.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "auth": "node ./dist/src/index.js auth",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node ./scripts/build-portal-assets.mjs",
    "check": "tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p ui/web/tsconfig.json",
    "doctor": "node ./dist/src/index.js doctor",
    "portal": "node ./dist/src/index.js portal",
    "repl": "node ./dist/src/index.js repl",
    "setup": "node ./dist/src/index.js setup",
    "prepare": "npm run build",
    "start": "node ./dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "web": "node ./dist/src/index.js portal",
    "web:build": "vite build --config ui/web/vite.config.ts",
    "web:dev": "vite --host 127.0.0.1 --config ui/web/vite.config.ts",
    "web:e2e": "npm run build && playwright test --config ui/web/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.67.68",
    "@mariozechner/pi-tui": "^0.67.68",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sinclair/typebox": "^0.34.49",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  }
}
